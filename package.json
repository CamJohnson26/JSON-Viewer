{
  "name": "json-viewer",
  "version": "0.1.0",
  "description": "A fast, graphical JSON editor.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:browser": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:browser && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamJohnson26/JSON-Viewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CamJohnson26/JSON-Viewer/issues"
  },
  "homepage": "https://github.com/CamJohnson26/JSON-Viewer#readme",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@xstate/react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
